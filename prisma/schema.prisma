// ... existing content until the end of the file

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Gamification Models
model Achievement {
  id            String   @id @default(cuid())
  name          String
  description   String?
  icon          String   @default("🏆")
  category      AchievementCategory
  points        Int      @default(10)
  rarity        Rarity   @default(COMMON)
  criteria      Json     // Criteria for unlocking the achievement
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userAchievements UserAchievement[]

  @@index([category, rarity])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0) // Progress towards achievement (0-100)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model UserReward {
  id            String   @id @default(cuid())
  userId        String
  rewardId      String
  claimedAt     DateTime?
  isClaimed     Boolean  @default(false)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rewardId])
  @@map("user_rewards")
}

model SocialActivity {
  id           String   @id @default(cuid())
  userId       String
  type         String   // task_completed, achievement_unlocked, challenge_won, streak_milestone
  title        String
  description  String?
  createdAt    DateTime @default(now())
  metadata     Json?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@map("social_activities")
}

model UserShare {
  id            String   @id @default(cuid())
  userId        String
  type          String   // achievement_unlock, milestone, challenge_win, badge_earned
  message       String
  platform      String?  // twitter, linkedin, discord, facebook
  postedAt      DateTime
  metadata      Json?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postedAt])
  @@map("user_shares")
}

model UserPoints {
  id            String   @id @default(cuid())
  userId        String
  totalPoints   Int      @default(0)
  level         Int      @default(1)
  currentLevelXp Int     @default(0)
  levelXpRequired Int    @default(100)
  lastUpdated   DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_points")
}

model UserLevel {
  id            String   @id @default(cuid())
  userId        String
  level         Int      @default(1)
  xp            Int      @default(0)
  xpToNextLevel Int      @default(100)
  lastUpdated   DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("user_levels")
}

model Leaderboard {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          LeaderboardType
  period        LeaderboardPeriod
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries       LeaderboardEntry[]

  @@index([type, period])
  @@map("leaderboards")
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  leaderboardId String
  userId        String
  rank          Int
  score         Int
  previousRank  Int?
  updatedAt     DateTime @updatedAt

  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
  @@index([rank])
  @@map("leaderboard_entries")
}

model Challenge {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          ChallengeType
  startDate     DateTime
  endDate       DateTime
  rewardPoints  Int      @default(50)
  rewardBadgeId String?
  maxParticipants Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants  ChallengeParticipant[]
  rewardBadge   Achievement? @relation(fields: [rewardBadgeId], references: [id])

  @@index([startDate, endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id            String   @id @default(cuid())
  challengeId   String
  userId        String
  joinedAt      DateTime @default(now())
  progress      Int      @default(0) // Progress percentage
  score         Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?

  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

model SkillTree {
  id            String   @id @default(cuid())
  userId        String
  name          String   @default("Main Skill Tree")
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes         SkillTreeNode[]

  @@unique([userId])
  @@map("skill_trees")
}

model SkillTreeNode {
  id            String   @id @default(cuid())
  skillTreeId   String
  name          String
  description   String?
  icon          String   @default("⚡")
  xpValue       Int      @default(10)
  prerequisites Json     // Array of node IDs that must be completed first
  isUnlocked    Boolean  @default(false)
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  positionX     Int      @default(0) // For visual positioning
  positionY     Int      @default(0)

  skillTree     SkillTree @relation(fields: [skillTreeId], references: [id], onDelete: Cascade)

  @@map("skill_tree_nodes")
}

// Enums
enum AchievementCategory {
  PRODUCTIVITY
  COLLABORATION
  LEARNING
  STREAK
  SOCIAL
  CUSTOMIZATION
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum LeaderboardType {
  POINTS
  LEVEL
  STREAK
  TASKS_COMPLETED
  CHALLENGES_WON
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum ChallengeType {
  INDIVIDUAL
  TEAM
  WORKSPACE
  GLOBAL
}